   "source": [
    "#| label: tbl-mn-BP-met-conv\n",
    "#| tbl-cap: Methane conversion factor values for bedded pack pens, based on presence or absence of mixing and average annual air temperature.\n",
    "import_table(\n",
    "  \"../resources/table_data/manure/tbl-mn-BP-met-conv.csv\",\n",
    "  colalign = [\"left\", \"center\", \"center\",\"center\",\"center\",\"center\"]\n",
